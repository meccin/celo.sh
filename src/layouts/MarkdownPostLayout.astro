---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} :: Marcelo Pecin`} description={frontmatter.excerpt} type="article">
    <article class="post">
        <a class="post-back" href="/">← celo.sh</a>
        <h1>{frontmatter.title}</h1>
        <p class="post-date">
            {
                new Date(frontmatter.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                })
            }
        </p>
        <slot />
    </article>
</Layout>

<style is:global>
    .post {
        max-width: 680px;
        margin: 0 auto;
        padding: 72px 32px 96px;
        font-size: 16.5px;
        line-height: 1.7;
        color: var(--ink2);
    }
    .post h1,
    .post h2,
    .post h3 {
        font-family: var(--serif);
        font-weight: 400;
        color: var(--ink);
        letter-spacing: -0.01em;
        margin: 1.6em 0 0.5em;
    }
    .post h1 {
        font-size: clamp(32px, 4.6vw, 44px);
        line-height: 1.12;
        margin-top: 24px;
    }
    .post p,
    .post ul,
    .post ol,
    .post pre {
        margin: 0 0 1.1em;
    }
    .post a {
        border-bottom: 1px solid var(--line);
    }
    .post a:hover {
        border-color: var(--accent);
    }
    .post-back,
    .post-date {
        font-family: var(--mono);
        font-size: 13px;
        color: var(--ink3);
    }
    .post .post-back {
        border: 0;
    }
    .post code {
        font-family: var(--mono);
        font-size: 0.88em;
        color: var(--ink);
    }
    .post pre {
        padding: 20px;
        border: 1px solid var(--line);
        border-radius: 4px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
    }
    .post pre code {
        font-size: inherit;
    }
</style>
